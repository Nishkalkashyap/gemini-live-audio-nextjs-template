{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", "apps/*/.env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "GEMINI_API_KEY",
        "GEMINI_LIVE_MODEL",
        "GEMINI_LIVE_VOICE",
        "NEXT_PUBLIC_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
